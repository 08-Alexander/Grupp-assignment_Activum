<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PRG1_MAUI_ERP_Activum.View.Customer.CustomerHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shared="clr-namespace:PRG1_MAUI_ERP_Activum.View.Shared"
    Title="Min sida">


    <VerticalStackLayout>
        <Label
        Padding="20"
        Text="Kunder"
        Style="{StaticResource Headline}"
        SemanticProperties.HeadingLevel="Level1"
        VerticalOptions="Center" 
        HorizontalOptions="Center" />
        <Label
        Padding="10"
        Text=" Hej och välkommen till Kunder sidan. Här kan du få en bra över blick på kunderna."
        FontSize="15"
        Style="{StaticResource SubHeadline}"
        SemanticProperties.HeadingLevel="Level1"/>
        <Entry
        Placeholder="Namn"/>
        <Entry
        Placeholder="Person nummer"/>
        <Entry
        Placeholder="Kund nummer"/>

    </VerticalStackLayout>
</ContentPage>
