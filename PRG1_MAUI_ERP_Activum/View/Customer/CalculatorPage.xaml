<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PRG1_MAUI_ERP_Activum.View.Customer.CalculatorPage"
    Title="Kalkylator"
    BackgroundColor="#202020">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BackgroundColor" Value="#333333"/>
            <Setter Property="TextColor" Value="White"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout>

            <Label x:Name="HistoryLabel"
                   FontSize="14"
                   TextColor="White"
                   BackgroundColor="#121212"
                   HorizontalTextAlignment="End"
                   HeightRequest="40"/>

            <Entry x:Name="Display"
                   FontSize="36"
                   TextColor="White"
                   BackgroundColor="#121212"
                   IsReadOnly="True"
                   HorizontalTextAlignment="End"
                   HeightRequest="100"/>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Text="MC" Grid.Row="0" Grid.Column="0" Clicked="MemoryClear_Click"/>
                <Button Text="MR" Grid.Row="0" Grid.Column="1" Clicked="MemoryRecall_Click"/>
                <Button Text="M+" Grid.Row="0" Grid.Column="2" Clicked="MemoryAdd_Click"/>
                <Button Text="M-" Grid.Row="0" Grid.Column="3" Clicked="MemorySubtract_Click"/>

                <Button Text="%" Grid.Row="1" Grid.Column="0" Clicked="Operation_Click"/>
                <Button Text="CE" Grid.Row="1" Grid.Column="1" Clicked="ClearEntry_Click"/>
                <Button Text="C" Grid.Row="1" Grid.Column="2" Clicked="Clear_Click"/>
                <Button Text="←" Grid.Row="1" Grid.Column="3" Clicked="Backspace_Click"/>

                <Button Text="1/x" Grid.Row="2" Grid.Column="0" Clicked="Operation_Click"/>
                <Button Text="^" Grid.Row="2" Grid.Column="1" Clicked="Operation_Click"/>
                <Button Text="√" Grid.Row="2" Grid.Column="2" Clicked="Operation_Click"/>
                <Button Text="÷" Grid.Row="2" Grid.Column="3" Clicked="Operation_Click"/>

                <Button Text="7" Grid.Row="3" Grid.Column="0" Clicked="Number_Click"/>
                <Button Text="8" Grid.Row="3" Grid.Column="1" Clicked="Number_Click"/>
                <Button Text="9" Grid.Row="3" Grid.Column="2" Clicked="Number_Click"/>
                <Button Text="×" Grid.Row="3" Grid.Column="3" Clicked="Operation_Click"/>

                <Button Text="4" Grid.Row="4" Grid.Column="0" Clicked="Number_Click"/>
                <Button Text="5" Grid.Row="4" Grid.Column="1" Clicked="Number_Click"/>
                <Button Text="6" Grid.Row="4" Grid.Column="2" Clicked="Number_Click"/>
                <Button Text="-" Grid.Row="4" Grid.Column="3" Clicked="Operation_Click"/>

                <Button Text="1" Grid.Row="5" Grid.Column="0" Clicked="Number_Click"/>
                <Button Text="2" Grid.Row="5" Grid.Column="1" Clicked="Number_Click"/>
                <Button Text="3" Grid.Row="5" Grid.Column="2" Clicked="Number_Click"/>
                <Button Text="+" Grid.Row="5" Grid.Column="3" Clicked="Operation_Click"/>

                <Button Text="+/-" Grid.Row="6" Grid.Column="0" Clicked="PlusMinus_Click"/>
                <Button Text="0" Grid.Row="6" Grid.Column="1" Clicked="Number_Click"/>
                <Button Text="." Grid.Row="6" Grid.Column="2" Clicked="Decimal_Click"/>
                <Button Text="=" Grid.Row="6" Grid.Column="3" Clicked="Equals_Click"
                        BackgroundColor="#4F94D4"/>
            </Grid>

        </StackLayout>
    </ScrollView>
</ContentPage>
