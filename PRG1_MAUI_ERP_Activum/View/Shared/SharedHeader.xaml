<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PRG1_MAUI_ERP_Activum.View.Shared.SharedHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        HeightRequest="80"
        BackgroundColor="#134f5c"
        Padding="20,0"
        ColumnDefinitions="*,Auto"
        VerticalOptions="Start">

        <!-- App name -->
        <Label
            Text="ACTIVUM"
            TextColor="White"
            FontSize="24"
            FontAttributes="Bold"
            VerticalOptions="Center" />

        <!-- Profile / menu icon -->
        <Image
            Grid.Column="1"
            Source="dotnet_bot.png"
            HeightRequest="28"
            WidthRequest="28"
            VerticalOptions="Center" />

    </Grid>
</ContentView>
