<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PRG1_MAUI_ERP_Activum.View.Employee.RiskSettingsPage"
    Title="Riskinställningar">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Riskfaktorer"
               FontSize="20"
               FontAttributes="Bold" />

        <Entry x:Name="LowEntry" Placeholder="Låg risk" Keyboard="Numeric" />
        <Entry x:Name="MediumEntry" Placeholder="Medel risk" Keyboard="Numeric" />
        <Entry x:Name="HighEntry" Placeholder="Hög risk" Keyboard="Numeric" />

        <Button Text="Spara"
                BackgroundColor="#134f5c"
                TextColor="White"
                Clicked="OnSaveClicked"/>

    </VerticalStackLayout>
</ContentPage>

